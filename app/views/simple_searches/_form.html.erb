<div class="row justify-content-center my-4">
  <div class="col-12 col-md-8 col-lg-7 col-xl-6">
    <%= form_tag(
          {:controller => controller, :action => action, :uuid => ''},
          :method => "POST") do %>

      <div class="input-group input-group-lg shadow-sm mb-3 simple-search-input-group">
        <span class="input-group-text bg-white text-muted border-end-0">
          <%= fa_icon("search") %>
        </span>
        <%= text_field_tag(
              :q,
              @saved_search&.query,
              :class => "form-control border-start-0 ps-1 shadow-none",
              :placeholder => @item_type.present? ? t('.placeholder', :item_type => @item_type.name_plural) : t('.default_placeholder'),
              :autofocus => true
            ) %>
        <%= submit_tag(t(".submit"), :class => "btn btn-primary px-4 fw-medium") %>
      </div>

      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-1">
        <div class="d-flex align-items-center gap-2">
          <span class="small text-muted fw-medium d-none d-md-inline text-nowrap"><%= t('.search_mode') %></span>

          <div class="btn-group btn-group-sm border rounded-pill bg-white p-1 shadow-sm" role="group">
            <%= radio_button_tag(:prefix, "true",
                  @saved_search.nil? || @saved_search.prefix,
                  :id => "modeStartsWith",
                  :class => "btn-check") %>
            <label class="btn btn-sm btn-light rounded-pill px-3 fw-medium text-secondary text-nowrap me-1" for="modeStartsWith">
              <%= t('.mode_broad') %>
            </label>

            <%= radio_button_tag(:prefix, "false",
                  @saved_search.present? && !@saved_search.prefix,
                  :id => "modeWholeWords",
                  :class => "btn-check") %>
            <label class="btn btn-sm btn-light rounded-pill px-3 fw-medium text-secondary text-nowrap" for="modeWholeWords">
              <%= t('.mode_strict') %>
            </label>
          </div>

          <span class="text-muted"
                data-bs-toggle="popover"
                data-bs-trigger="hover focus"
                data-bs-placement="top"
                data-bs-content="<%= t('.mode_tooltip') %>"
                tabindex="0"
                style="cursor: pointer;">
            <%= fa_icon("info-circle") %>
          </span>
        </div>

        <% if display_advanced_search %>
          <%= link_to(
                new_advanced_search_path,
                :class => "text-decoration-none fw-semibold link-primary d-flex align-items-center gap-1") do %>
            <%= t(".advanced") %> <%= fa_icon("chevron-right") %>
          <% end %>
        <% end %>
      </div>

    <% end %>
  </div>
</div>


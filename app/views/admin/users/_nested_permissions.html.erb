<% permissions.each do |perm| %>
  <tr>
    <%= f.fields_for(:catalog_permissions, perm) do |f| %>
      <%= f.hidden_field(:catalog_id) %>
      <th class="align-middle admin-users-permissions-catalog"><%= perm.catalog.name %></th>
      <td class="admin-users-permissions-roles">
        <%= render_users_role_button_bar(f) %>
      </td>
    <% end %>
  </tr>
<% end %>
